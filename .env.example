# Copy to .env  (the server loads it automatically with Node's --env-file)
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stable flash model with vision. Override to any Gemini model you have access to.
# Current stable flash ids: gemini-3.5-flash, gemini-3.6-flash, gemini-3.7-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash

# Comma separated fallbacks tried in order if GEMINI_MODEL is rejected.
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash

# 0.0 - 1.0. Keep this low: this is an extraction task, not a creative one.
GEMINI_TEMPERATURE=0

# Host/port the Node API binds to. Must stay 0.0.0.0 inside the sandbox preview.
API_HOST=0.0.0.0
API_PORT=4000

# Where the Next.js dev server finds the API. Server-side only (rewrites),
# so localhost is correct even when the browser is remote.
API_BASE_URL=http://127.0.0.1:4000

# Set to "true" to force the offline mock extractor instead of calling Gemini.
# Useful for development without burning quota, and used automatically when no key is set.
VISION_MOCK=false
